# ── Firebase ─────────────────────────────────────────────────
# JSON completo de la cuenta de servicio (Console → Project settings →
# Service accounts → Generar clave). Una sola línea, tal cual el archivo.
FIREBASE_SERVICE_ACCOUNT=
# Config web de Firebase (apiKey, authDomain, ...) como JSON.
NUXT_PUBLIC_FIREBASE_CONFIG=

# ── App Check (requiere Blaze + registro Fraud Defense) ──────
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
APP_CHECK_ENFORCE=0

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Endpoint https://<dominio>/api/webhooks/stripe — suscribir:
# payment_intent.succeeded, payment_intent.payment_failed,
# charge.refunded, checkout.session.completed (ads self-serve) y
# checkout.session.expired (opcional).
STRIPE_WEBHOOK_SECRET=

# ── Cron ─────────────────────────────────────────────────────
# Vercel manda `Authorization: Bearer $CRON_SECRET` en los crons
# declarados en vercel.json. También lo usa cron-job.org
# (auto-checkout cada 15 min).
CRON_SECRET=

# ── Push scheduler (apagado por default) ─────────────────────
PUSH_DISPATCH_SECRET=

# ── SMTP (correo de claim PIN a socios) ──────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Links de la app (para correos/QR del B2B) ────────────────
APP_IOS_URL=
APP_ANDROID_URL=

# ── Rate limit distribuido (opcional) ────────────────────────
# Upstash Redis REST — conteo real entre instancias serverless.
# Sin estas vars el límite corre solo en memoria por instancia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
